<?php

declare(strict_types=1);

/**
 * Copy this file to secret.php (gitignored, never commit the real one) and
 * set a long random token - generate one with:
 *
 *   openssl rand -hex 32
 *
 * Put the same value in the DEPLOY_TOKEN GitHub Actions secret. scripts/
 * deploy.sh derives the deploy endpoint's random filename from this same
 * token, so it must match exactly on both sides. See the README's "部署"
 * section for the one-time bootstrap steps (this file has to reach the
 * server by hand/FTP before the first automated deploy - deploy.sh never
 * uploads it).
 */

define('DEPLOY_TOKEN', 'REPLACE_ME_WITH_A_LONG_RANDOM_TOKEN');
