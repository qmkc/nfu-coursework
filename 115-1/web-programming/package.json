{
  "name": "web-programming",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "php src/compile.php && vite build",
    "dev": "nodemon",
    "lint:html": "pnpm run build && htmlhint \"dist/**/*.html\"",
    "lint:css": "stylelint \"public/**/*.css\"",
    "lint:ts": "tsc --noEmit",
    "lint": "pnpm run lint:html && pnpm run lint:css && pnpm run lint:ts"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "htmlhint": "^1.5.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "public"
    ],
    "ext": "php,ts,tsx,css,txt",
    "ignore": [
      "dist"
    ],
    "delay": 300,
    "exec": "php src/compile.php && node_modules/.bin/vite build && php8.3 -S 0.0.0.0:9000 -t dist dist/router.php"
  }
}
